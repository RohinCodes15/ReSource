{
  "expo": {
    "name": "ReSource",
    "slug": "resource",
    "scheme": "resource",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.resource.fremont"
    },
    "android": {
      "package": "org.resource.fremont",
      "adaptiveIcon": {
        "backgroundColor": "#1B3A6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "themeColor": "#1B3A6B",
      "backgroundColor": "#F6F2E9"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": "development"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ReSource uses your location to show the resources closest to you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReSource needs photo access so you can attach a picture to a service disruption report."
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B3A6B"
        }
      ]
    ],
    "description": "See which Fremont, California city services changed with the city budget, and where to find help. An independent student project."
  }
}
