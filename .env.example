# ReSource reads two env files, each with its own template:
#
#   backend/.env   copy from backend/.env.example   server-side secrets (never in the app)
#   app/.env       copy from app/.env.example       EXPO_PUBLIC_* values, which are public
#
# Both are optional. With neither file the backend runs on bundled data and the app talks to
# http://localhost:8000. deployment/ENV.md lists every variable in one table.
#
# docker compose reads this root .env for the optional values below.
ANTHROPIC_API_KEY=
ADMIN_TOKEN=
