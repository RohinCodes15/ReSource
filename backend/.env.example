# Copy to backend/.env. Every value is optional: with all of them empty the API runs in local
# mode on the bundled data. deployment/ENV.md explains each one. Never commit the real file.

# Live database (leave empty for local mode). The service-role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-photos

# Assistant (leave empty for "basic search" mode, which needs no key).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Browser origins allowed to call the API, comma separated. Use your real web address in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# A long random string you choose. Unlocks the Admin and Community Impact screens.
ADMIN_TOKEN=
# A long random string. Hashes install tokens so stored rows cannot be tied back to a device.
OWNER_HASH_SALT=
# Set to 1 only when the API sits behind a proxy you trust (Railway, Render, Fly).
TRUST_PROXY=0

# Email alerts are off unless all of these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_API_URL=
CONTACT_EMAIL=
