# Copy to backend/.env. Every value is optional: with all of them empty the API runs in local
# mode on the bundled data. deployment/ENV.md explains each one. Never commit the real file.

# Live database (leave empty for local mode). The service-role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-photos

# Assistant: a general-purpose Claude assistant. Leave the key empty for "basic search" mode,
# a keyword lookup of the app's data that needs no key. Paste your key from console.anthropic.com.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Shared /chat and /chat/stream ceiling per rolling 24 hours (positive integer).
# Counters live in memory: run one API worker; use shared storage before scaling workers.
CHAT_GLOBAL_DAILY_LIMIT=2000
# Tokens (input + output) Claude may use per rolling 24 hours before chat drops to basic search.
# 400000 is about 300 answers, roughly $3 a day at Sonnet 5 prices.
CHAT_DAILY_TOKEN_BUDGET=400000

# Browser origins allowed to call the API, comma separated. Use your real web address in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# At least 24 characters. Generate a random value; unlocks Admin Tools and the export.
ADMIN_TOKEN=
# A long random string. Hashes install tokens so stored rows cannot be tied back to a device.
OWNER_HASH_SALT=
# Set to 1 only when the API sits behind a proxy you trust (Railway, Render, Fly).
TRUST_PROXY=0

# Email alerts are off unless all of these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_API_URL=
CONTACT_EMAIL=
